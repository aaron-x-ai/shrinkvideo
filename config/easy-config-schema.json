{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShrinkVideo",
  "type": "object",
  "properties": {
    "inbox_enabled": {
      "type": "boolean",
      "title": "启用中转目录工作流",
      "default": true
    },
    "staging_dir": {
      "type": "string",
      "title": "中转目录（放入待压缩原视频）",
      "minLength": 1
    },
    "output_dir": {
      "type": "string",
      "title": "目标目录（压缩结果输出）",
      "minLength": 1
    },
    "video_glob": {
      "type": "string",
      "title": "视频文件匹配（不含图片）",
      "default": "*.{mp4,mov,mkv,avi,webm,m4v,ts,mts}"
    },
    "after_success": {
      "type": "string",
      "title": "压缩成功后原文件",
      "enum": ["keep", "archive", "delete"],
      "default": "keep"
    },
    "default_codec": {
      "type": "string",
      "title": "视频编码",
      "enum": ["auto", "hevc_videotoolbox", "libx265", "libsvtav1", "libaom-av1"],
      "default": "auto"
    },
    "default_quality": {
      "type": "string",
      "title": "画质/体积平衡",
      "enum": ["best", "balanced", "smallest"],
      "default": "balanced"
    },
    "default_suffix": {
      "type": "string",
      "title": "输出文件名后缀",
      "default": "_shr"
    }
  },
  "required": ["staging_dir", "output_dir"],
  "additionalProperties": false,
  "x-easy-config": {
    "version": 1,
    "writeTarget": "~/.config/shrinkvideo/config.yaml",
    "format": "yaml",
    "fieldPaths": {
      "inbox_enabled": ["inbox", "enabled"],
      "staging_dir": ["inbox", "staging_dir"],
      "output_dir": ["inbox", "output_dir"],
      "video_glob": ["inbox", "glob"],
      "after_success": ["inbox", "after_success"],
      "default_codec": ["defaults", "codec"],
      "default_quality": ["defaults", "quality"],
      "default_suffix": ["defaults", "suffix"]
    },
    "ui": {
      "staging_dir": {
        "widget": "directory",
        "help": "仅放视频文件；放入后请在飞书/Hermes 说「开始视频压缩」（不会自动监听）"
      },
      "output_dir": {
        "widget": "directory",
        "help": "压缩结果如 name_shr.mp4；勿与中转目录相同"
      },
      "video_glob": {
        "help": "仅匹配视频扩展名，不处理图片"
      },
      "after_success": {
        "help": "keep=保留原文件；archive/delete 见产品开发文档"
      },
      "default_suffix": {
        "help": "默认 _shr，生成 vacation_shr.mp4"
      }
    },
    "reloadHint": "已保存。把视频放入中转目录后，在飞书或 Hermes 发送：开始视频压缩"
  }
}
