{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShrinkVideo",
  "type": "object",
  "properties": {
    "inbox_enabled": {
      "type": "boolean",
      "title": "启用中转目录工作流",
      "default": true
    },
    "staging_dir": {
      "type": "string",
      "title": "中转目录（放入待压缩原视频）",
      "minLength": 1
    },
    "output_dir": {
      "type": "string",
      "title": "目标目录（压缩结果输出）",
      "minLength": 1
    },
    "video_glob": {
      "type": "string",
      "title": "视频文件匹配（不含图片）",
      "default": "*.{mp4,mov,mkv,avi,webm,m4v,ts,mts}"
    },
    "after_success": {
      "type": "string",
      "title": "压缩成功后原文件",
      "enum": ["keep", "archive", "delete"],
      "default": "keep"
    },
    "continue_on_error": {
      "type": "boolean",
      "title": "单个文件失败时继续批处理",
      "default": true
    },
    "default_codec": {
      "type": "string",
      "title": "视频编码",
      "enum": ["auto", "hevc_videotoolbox", "libx265", "libsvtav1", "libaom-av1"],
      "default": "auto"
    },
    "default_quality": {
      "type": "string",
      "title": "画质/体积平衡",
      "enum": ["best", "balanced", "smallest"],
      "default": "balanced"
    },
    "default_resolution": {
      "type": "string",
      "title": "输出分辨率（scale）",
      "enum": ["1920:-2", "1280:-2", "2560:-2", "3840:-2"],
      "default": "1920:-2"
    },
    "default_suffix": {
      "type": "string",
      "title": "输出文件名后缀（无模板时与 basename 拼接）",
      "default": "_shr",
      "minLength": 1
    },
    "output_name_template": {
      "type": "string",
      "title": "成品命名模板",
      "default": "{datetime}_{basename}_shr",
      "minLength": 1
    },
    "default_overwrite": {
      "type": "boolean",
      "title": "覆盖已有成品（同名有效 _shr 也重压）",
      "default": false
    }
  },
  "required": ["staging_dir", "output_dir"],
  "additionalProperties": false,
  "x-easy-config": {
    "version": 1,
    "writeTarget": "~/.config/shrinkvideo/config.yaml",
    "format": "yaml",
    "compatible": true,
    "fieldPaths": {
      "inbox_enabled": ["inbox", "enabled"],
      "staging_dir": ["inbox", "staging_dir"],
      "output_dir": ["inbox", "output_dir"],
      "video_glob": ["inbox", "glob"],
      "after_success": ["inbox", "after_success"],
      "continue_on_error": ["inbox", "continue_on_error"],
      "default_codec": ["defaults", "codec"],
      "default_quality": ["defaults", "quality"],
      "default_resolution": ["defaults", "resolution"],
      "default_suffix": ["defaults", "suffix"],
      "output_name_template": ["defaults", "output_name_template"],
      "default_overwrite": ["defaults", "overwrite"]
    },
    "ui": {
      "staging_dir": {
        "widget": "directory",
        "help": "仅放视频；放入后在飞书/Hermes 说「开始视频压缩」（不会自动监听目录）"
      },
      "output_dir": {
        "widget": "directory",
        "help": "输出如 vacation_shr.mov；勿与中转目录设为同一路径"
      },
      "video_glob": {
        "help": "仅匹配视频扩展名，不处理图片"
      },
      "after_success": {
        "help": "keep=保留原片；archive=移到 .processed；delete=成功后删除原片"
      },
      "continue_on_error": {
        "help": "批处理时一个文件失败是否继续压其余文件"
      },
      "default_codec": {
        "help": "auto 为本机最佳 HEVC（如 Apple VideoToolbox）"
      },
      "default_quality": {
        "help": "best / balanced / smallest 对应不同 CRF"
      },
      "default_resolution": {
        "help": "默认 1080p：1920:-2（与 ShrinkMaster 高级设置一致）"
      },
      "default_suffix": {
        "help": "仅当未用模板时的后备：vacation + _shr"
      },
      "output_name_template": {
        "help": "占位符 {datetime}=20240531_143022（ffprobe 拍摄时间，读不出则省略）；{basename}=原文件名无扩展名"
      },
      "default_overwrite": {
        "help": "关闭时：有效成品 + 源文件未变则跳过；开启则强制重压"
      }
    },
    "reloadHint": "已保存。把视频放入中转目录后，在飞书或 Hermes 发送：开始视频压缩"
  }
}
